# Signing secret of the Linear webhook (Settings > API > Webhooks). Required.
LINEAR_WEBHOOK_SECRET=

# Required. JSON object mapping Linear project UUID -> Slack Incoming Webhook URL.
# The key is the project UUID (not the P-XXX slug). Issues from projects that are
# not listed (or have no project) are skipped with a log line.
SLACK_PROJECT_WEBHOOKS={"<linear-project-uuid>":"https://hooks.slack.com/services/T000/B000/XXXX"}

# HTTP port. Optional, defaults to 3000.
PORT=3000

# Optional. JSON object mapping Linear user ID -> Slack member ID, so messages
# mention people with real Slack mentions. Unmapped users fall back to their name.
# SLACK_USER_MAP={"<linear-user-id>":"U0123ABCDEF"}
