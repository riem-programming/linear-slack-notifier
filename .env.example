# Required secrets (placeholders only, never commit real values)
LINEAR_WEBHOOK_SECRET=replace-with-linear-webhook-signing-secret
LINEAR_API_KEY=replace-with-linear-personal-api-key
SLACK_BOT_TOKEN=xoxb-replace-with-bot-token
SLACK_SIGNING_SECRET=replace-with-slack-signing-secret
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional (defaults shown)
PORT=3000
# The default /data/notifier.db requires the /data volume (Docker/Dokploy).
# For local runs point it at a writable path, e.g. ./data/notifier.db
DATABASE_PATH=./data/notifier.db
BACKUP_DIR=./data/backups
BACKUP_KEEP=7
EVENT_LOG_RETENTION_DAYS=30
STATUS_TIME_ZONE=America/Lima
